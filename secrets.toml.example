# Copy the values you need into Streamlit Cloud → Settings → Secrets.
# Never commit the real file: it is covered by .gitignore.

# --- Portal credentials -----------------------------------------------------
HKUST_VENDOR_ID = ""
HKUST_PASSWORD = ""
CUHK_USER_ID = ""
CUHK_PASSWORD = ""
CITYU_USER_ID = ""
CITYU_PASSWORD = ""

# --- Gmail ------------------------------------------------------------------
GMAIL_USER = ""
GMAIL_APP_PASSWORD = ""
GMAIL_DRAFTS_URL = "https://mail.google.com/mail/#drafts"
MAIL_TAG = "HKUST Tenders"
MAIL_LOOKBACK_DAYS = "60"

# --- Company details used in drafts ----------------------------------------
COMPANY_NAME = ""
CONTACT_PERSON_NAME = ""
CONTACT_EMAIL = ""
CONTACT_PHONE = ""
COMPANY_ADDRESS = ""
# SIGN_OFF = "Best regards,\nYour Name\nYour Company"

# --- Business Registration certificate -------------------------------------
# base64 of the PDF: base64 -i assets/br.pdf | tr -d '\n'
# For very large values use BR_CERTIFICATE_B64_1, _2, ... in order instead.
BR_CERTIFICATE_B64 = ""

# --- Hosting ----------------------------------------------------------------
RUNTIME_DIR = "/tmp/tender-runtime"
PLAYWRIGHT_LAUNCH_ARGS = "--no-sandbox --disable-dev-shm-usage --disable-gpu"

# --- Login (streamlit-authenticator) ---------------------------------------
# Generate a hash with:
#   python -c "import streamlit_authenticator as s; print(s.Hasher.hash('your-password'))"
[auth]
cookie_name = "tender_app"
cookie_key = "replace-with-a-long-random-string"
cookie_expiry_days = 1

[auth.credentials.usernames.alice]
name = "Alice"
email = "alice@example.com"
password = "<bcrypt-hash>"

# Alternative without streamlit-authenticator: one shared password.
# WEB_PASSWORD = "replace-with-a-strong-password"
# WEB_USERNAME = "team"
