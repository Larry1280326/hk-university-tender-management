# HKUST Vendor Portal Credentials
HKUST_VENDOR_ID=
HKUST_PASSWORD=

# Path to your Business Registration (BR) Certificate file (PDF, PNG, etc.)
BR_CERTIFICATE_PATH=

# Google Account (Using App Password - No Google Cloud setup required!)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_DRAFTS_URL=
HKUST_MAIL_TAG=

# Company Info Defaults (Optional overrides)
COMPANY_NAME=
CONTACT_PERSON_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=
COMPANY_ADDRESS=

# Portal URLs (Optional overrides - defaults already point at the live portal)
# HKUST_WELCOME_URL=
# HKUST_LOGIN_URL=
# HKUST_TENDER_NOTICE_URL=

# Navigation tuning (Optional - all values below are the defaults)
# The login page loads Google reCAPTCHA from an external host, which is slow on a
# busy link, so waits are pinned to page elements rather than to network idleness.
HKUST_NAV_TIMEOUT_MS=15000          # loading the page document itself
HKUST_READY_TIMEOUT_MS=15000        # waiting for a specific element to appear
HKUST_SCRIPT_TIMEOUT_MS=30000       # waiting for the reCAPTCHA library to load
HKUST_POST_LOGIN_TIMEOUT_MS=20000   # waiting for the login result (never retried)
HKUST_DETAIL_TIMEOUT_MS=20000       # per-tender detail page
HKUST_NAV_ATTEMPTS=3                # set to 1 to disable retries
HKUST_NAV_BACKOFF_SECONDS=2.0       # sleeps 2s, then 4s, between attempts
HKUST_RETRY_ON_NET_ERRORS=true      # also retry transient network resets
HKUST_DEBUG_ARTIFACTS=true          # save screenshot + HTML to assets/debug/ on failure
